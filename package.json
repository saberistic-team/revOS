{
  "name": "agent-engine",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "demo": "tsx scripts/run-example.ts",
    "api": "tsx apps/api/src/index.ts",
    "worker": "tsx apps/worker/src/index.ts",
    "format": "prettier --write \"{apps,packages,scripts,tests}/**/*.ts\"",
    "secrets:openai": "bash scripts/load-openai-secret.sh",
    "db:seed:agent": "tsx scripts/seed-agent.ts",
    "demo:agent": "tsx scripts/run-agent-example.ts"
  },
  "dependencies": {
    "@openai/agents": "0.18.0",
    "@temporalio/activity": "1.24.0",
    "@temporalio/client": "1.24.0",
    "@temporalio/worker": "1.24.0",
    "@temporalio/workflow": "1.24.0",
    "ajv": "8.17.1",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.4",
    "pg": "8.16.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "@types/pg": "8.16.0",
    "drizzle-kit": "0.31.10",
    "prettier": "3.8.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
